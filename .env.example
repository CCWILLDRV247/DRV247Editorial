# Single password for /admin (required in production).
# Local fallback is desk247 if this is unset.
ADMIN_PASSWORD=desk247

# Turso (required on Vercel). Local `npm run dev` uses data/drv247.sqlite if these are unset.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Vercel Cron sends Authorization: Bearer $CRON_SECRET to /api/cron/ingest.
CRON_SECRET=

# Optional. Without these, leftover v1 YouTube/NewsAPI sources ingest mock items.
YOUTUBE_API_KEY=
NEWSAPI_KEY=

# Optional. Weekly cron + desk ingest-now fetch the original URL and store a short AI
# summary. Without a key, story pages hide the summary (no invented copy).
# Set on Vercel Preview + Production + Development.
OPENAI_API_KEY=

