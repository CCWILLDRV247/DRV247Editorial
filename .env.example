# Single password for /admin (required in production).
# Local fallback is desk247 if this is unset.
ADMIN_PASSWORD=desk247

# Turso (required on Vercel). Local `npm run dev` uses data/drv247.sqlite if these are unset.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Vercel Cron sends Authorization: Bearer $CRON_SECRET to /api/cron/ingest
# and /api/cron/intelligence-ingest (separate from the Monday editorial job).
CRON_SECRET=

# Optional. Server-side only. Without a key, YouTube channels ingest mock videos
# so local preview still works. Never expose this to the browser.
YOUTUBE_API_KEY=
# Optional cap on videos per channel (1–50). Defaults to the source max (8).
YOUTUBE_MAX_RESULTS=
NEWSAPI_KEY=

